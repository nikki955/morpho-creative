{
  "slug": "my-icp-slug",
  "name": "Human readable ICP name",
  "description": "One paragraph the qualifier reads. Who qualifies (business model, size, geography, who the buyer is), and who does not. Be concrete. This is the equivalent of Instantly's AI Search prompt.",
  "offer_context": "One or two sentences on what Morpho sells this ICP, so buying signals can be judged.",
  "search_terms": [
    "the phrases a local business in this ICP would be listed under on Google Maps",
    "two to six of them"
  ],
  "locations": {
    "region_key": [
      "Maine, USA",
      "New Hampshire, USA"
    ]
  },
  "max_results_per_search": 60,
  "batch_target": 100,
  "size": {
    "metric": "units",
    "label": "what the number counts (units, rooms, sites, employees, locations)",
    "min": 10,
    "max": 75,
    "sweet_min": 15,
    "sweet_max": 50,
    "require_verified": true,
    "patterns": [
      "(\\d{1,4})\\+?\\s*(?:vacation |short[- ]term )?(?:rentals?|homes|properties|units)"
    ],
    "listing_url_patterns": [
      "/property/",
      "/properties/",
      "/rentals/"
    ],
    "listing_index_paths": [
      "/rentals",
      "/properties"
    ]
  },
  "segments": [
    {
      "key": "small",
      "label": "Segment A",
      "min": 10,
      "max": 25,
      "target_share": 0.6
    },
    {
      "key": "mid",
      "label": "Segment B",
      "min": 26,
      "max": 75,
      "target_share": 0.3
    },
    {
      "key": "no_direct_booking",
      "label": "Segment C",
      "rule": "no_direct_booking",
      "target_share": 0.1
    }
  ],
  "buyer_types": {
    "options": {
      "owner_operator": "one property, owner on site most days; the owner is the front desk, maintenance escalation and marketing department",
      "portfolio_owner_manager": "owns or manages two to roughly ten properties, usually with a manager at each",
      "recent_acquirer": "bought the property in the last 24 months ('under new ownership', 'new owners')"
    },
    "on_ownership_change": "recent_acquirer",
    "on_portfolio_signal": "portfolio_owner_manager",
    "priority_bonus": {
